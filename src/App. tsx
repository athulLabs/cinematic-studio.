import { useEffect, useRef, useState } from 'react';
import {
  Aperture, ImagePlus, Play, Pause, Plus, Trash2,
  Download, Type, Layers, Sparkles, ZoomIn,
  MoveHorizontal, Film, ChevronDown, RotateCcw
} from 'lucide-react';

type Scene = {
  id: string;
  name: string;
  image: string;
  duration: number;
  zoom: number;
  movement: string;
  text: string;
};

export default function App() {
  const [scenes, setScenes] = useState<Scene[]>([]);
  const [selected, setSelected] = useState('');
  const [playing, setPlaying] = useState(false);
  const [time, setTime] = useState(0);
  const [showText, setShowText] = useState(true);
  const fileRef = useRef<HTMLInputElement>(null);
  const [projectName, setProjectName] = useState('Untitled Film');

  const current = scenes.find(s => s.id === selected) || scenes[0];
  const total = scenes.reduce((sum, s) => sum + s.duration, 0);

  useEffect(() => {
    if (!playing || total === 0) return;
    const start = performance.now() - time * 1000;
    let frame = 0;

    const tick = (now: number) => {
      const next = ((now - start) / 1000) % total;
      setTime(next);
      frame = requestAnimationFrame(tick);
    };

    frame = requestAnimationFrame(tick);
    return () => cancelAnimationFrame(frame);
  }, [playing, total]);

  const importImages = (files: FileList | null) => {
    if (!files) return;
    const additions: Scene[] = Array.from(files)
      .filter(f => f.type.startsWith('image/'))
      .map((file, i) => ({
        id: crypto.randomUUID(),
        name: file.name.replace(/\.[^.]+$/, ''),
        image: URL.createObjectURL(file),
        duration: 5,
        zoom: 1.18,
        movement: i % 2 ? 'left' : 'right',
        text: ''
      }));

    setScenes(old => [...old, ...additions]);
    if (additions.length) setSelected(additions[0].id);
  };

  const updateScene = (patch: Partial<Scene>) => {
    if (!current) return;
    setScenes(old => old.map(s =>
      s.id === current.id ? { ...s, ...patch } : s
    ));
  };

  const activeScene = (() => {
    let cursor = 0;
    for (const scene of scenes) {
      if (time < cursor + scene.duration) return scene;
      cursor += scene.duration;
    }
    return scenes[scenes.length - 1];
  })();

  const localTime = activeScene
    ? time - scenes.slice(0, scenes.indexOf(activeScene))
        .reduce((sum, s) => sum + s.duration, 0)
    : 0;

  const progress = activeScene
    ? Math.min(localTime / activeScene.duration, 1)
    : 0;

  return (
    <main className="studio">
      <header className="topbar">
        <div className="brand">
          <div className="brand-icon"><Aperture size={22} /></div>
          <div>
            <strong>CINEMATIC<span> STUDIO</span></strong>
            <small>CREATIVE MOTION ENGINE</small>
          </div>
        </div>
        <div className="top-actions">
          <span className="status"><i /> LOCAL PROJECT</span>
          <button className="icon-btn" onClick={() => {
            setScenes([]);
            setSelected('');
            setTime(0);
            setPlaying(false);
          }} title="New project"><Plus size={18} /></button>
        </div>
      </header>

      <section className="projectbar">
        <div>
          <span className="eyebrow">PROJECT / 001</span>
          <input
            className="project-name"
            value={projectName}
            onChange={e => setProjectName(e.target.value)}
            aria-label="Project name"
          />
        </div>
        <button className="export-btn" onClick={() => {
          const data = JSON.stringify({
            projectName,
            scenes: scenes.map(({ image, ...scene }) => scene)
          }, null, 2);
          const blob = new Blob([data], { type: 'application/json' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = 'cinematic-project.json';
          a.click();
          URL.revokeObjectURL(url);
        }}><Download size={16} /> SAVE PROJECT</button>
      </section>

      <section className="workspace">
        <aside className="toolrail">
          <button className="rail-item active"><Layers /><span>Scenes</span></button>
          <button className="rail-item" onClick={() => setShowText(!showText)}>
            <Type /><span>Typography</span>
          </button>
          <button className="rail-item" onClick={() => fileRef.current?.click()}>
            <ImagePlus /><span>Import</span>
          </button>
        </aside>

        <section className="editor">
          <div className="editor-heading">
            <div><span className="live-dot" /> LIVE COMPOSITION</div>
            <span className="resolution">9:16 / VERTICAL</span>
          </div>

          <div className="preview-stage">
            <div className="preview">
              {activeScene ? (
                <>
                  <img
                    key={activeScene.id}
                    className={`preview-image move-${activeScene.movement}`}
                    src={activeScene.image}
                    alt={activeScene.name}
                    style={{
                      transform: `scale(${1 + (activeScene.zoom - 1) * progress})`,
                    }}
                  />
                  <div className="preview-vignette" />
                  {showText && activeScene.text && (
                    <div className="preview-caption">{activeScene.text}</div>
                  )}
                  <div className="preview-label">SCENE {scenes.indexOf(activeScene) + 1}</div>
                </>
              ) : (
                <button className="empty-preview" onClick={() => fileRef.current?.click()}>
                  <div className="upload-orb"><ImagePlus size={30} /></div>
                  <strong>CREATE YOUR FIRST SCENE</strong>
                  <span>Import an image to begin</span>
                </button>
              )}
            </div>
          </div>

          <div className="transport">
            <button className="play-btn" onClick={() => {
              if (total > 0) setPlaying(!playing);
            }}>{playing ? <Pause size={18} /> : <Play size={18} fill="currentColor" />}</button>
            <span className="timecode">{time.toFixed(1)}s</span>
            <div className="transport-track">
              <div style={{ width: `${total ? time / total * 100 : 0}%` }} />
            </div>
            <span className="timecode">{total.toFixed(1)}s</span>
          </div>

          <div className="timeline-panel">
            <div className="section-title">
              <div><Film size={16} /> TIMELINE <span>{scenes.length} SCENES</span></div>
              <button className="small-add" onClick={() => fileRef.current?.click()}>
                <Plus size={15} /> ADD
              </button>
            </div>
            <div className="timeline">
              {scenes.map((scene, i) => (
                <button
                  key={scene.id}
                  className={`scene-card ${selected === scene.id ? 'selected' : ''}`}
                  onClick={() => {
                    setSelected(scene.id);
                    setTime(scenes.slice(0, i).reduce((sum, s) => sum + s.duration, 0));
                    setPlaying(false);
                  }}
                >
                  <img src={scene.image} alt="" />
                  <div className="scene-number">{String(i + 1).padStart(2, '0')}</div>
                  <span className="scene-duration">{scene.duration}s</span>
                </button>
              ))}
              <button className="add-scene" onClick={() => fileRef.current?.click()}>
                <Plus size={21} /><span>IMPORT SCENE</span>
              </button>
            </div>
          </div>
        </section>

        <aside className="inspector">
          <div className="inspector-heading">
            <Sparkles size={17} /> <strong>SCENE CONTROLS</strong>
          </div>

          {current ? (
            <>
              <div className="property-group">
                <label>SCENE NAME</label>
                <input value={current.name} onChange={e => updateScene({ name: e.target.value })} />
              </div>

              <div className="property-group">
                <label>CAMERA MOTION</label>
                <div className="motion-grid">
                  {['right', 'left', 'up', 'down'].map(m => (
                    <button key={m} className={current.movement === m ? 'motion-active' : ''}
                      onClick={() => updateScene({ movement: m })}>
                      <MoveHorizontal size={15} /> {m.toUpperCase()}
                    </button>
                  ))}
                </div>
              </div>

              <div className="property-group">
                <label><ZoomIn size={13} /> CAMERA ZOOM <span>{current.zoom.toFixed(2)}×</span></label>
                <input type="range" min="1" max="1.6" step="0.01" value={current.zoom}
                  onChange={e => updateScene({ zoom: Number(e.target.value) })} />
              </div>

              <div className="property-group">
                <label>DURATION <span>{current.duration}s</span></label>
                <input type="range" min="1" max="20" value={current.duration}
                  onChange={e => updateScene({ duration: Number(e.target.value) })} />
              </div>

              {showText && (
                <div className="property-group">
                  <label><Type size={13} /> OVERLAY TEXT</label>
                  <textarea placeholder="Enter your cinematic quote..." value={current.text}
                    onChange={e => updateScene({ text: e.target.value })} />
                </div>
              )}

              <button className="delete-btn" onClick={() => {
                setScenes(old => old.filter(s => s.id !== current.id));
                setSelected('');
                setPlaying(false);
              }}><Trash2 size={15} /> DELETE SCENE</button>
            </>
          ) : (
            <div className="inspector-empty">
              <ImagePlus size={27} />
              <p>Import an image to unlock scene controls.</p>
              <button onClick={() => fileRef.current?.click()}>IMPORT IMAGE</button>
            </div>
          )}

          <div className="engine-status">
            <span><i /> RENDER ENGINE</span>
            <strong>READY</strong>
            <small>CLIENT-SIDE PREVIEW</small>
          </div>
        </aside>
      </section>

      <footer className="footer">
        <span><span className="live-dot" /> ENGINE ONLINE</span>
        <span>1080 × 1920 TARGET</span>
        <span>BUILD 0.1.0</span>
      </footer>

      <input ref={fileRef} type="file" accept="image/*" multiple hidden
        onChange={e => {
          importImages(e.target.files);
          e.target.value = '';
        }} />
    </main>
  );
}
